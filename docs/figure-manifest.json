{
  "schema_version": "1.0",
  "project": "Multirotor Recovery Dynamics",
  "figures": [
    {
      "id": "qdrone-development-response",
      "evidence_type": "continuous response from public development observations",
      "scope": "QDrone2 original MPC, selected discharge; no recovery labels",
      "generator": "Analysis/plot_qdrone_response.py",
      "command": "python -m Analysis.plot_qdrone_response --cache /tmp/multirotor-qdrone-source --figure Figures/qdrone-development-response.png --tables docs",
      "inputs": [
        "Data/qdrone-response/sources.json",
        "Data/qdrone-response/protocol.json",
        "Data/qdrone-response/results.json",
        "Analysis/figure_style.py"
      ],
      "outputs": [
        "Figures/qdrone-development-response.png",
        "Figures/qdrone-development-response.pdf",
        "docs/qdrone-response-table.md",
        "docs/qdrone-response.csv"
      ],
      "data_outputs": [],
      "attribution": "Borbolla-Burillo et al., Experimental Setup and Experimental Results, doi:10.5281/zenodo.19464105, CC BY 4.0; metrics and plot derived here",
      "notes": "Stored result is read-only. Time traces read the SHA-256-pinned Fig13a workbook in the external cache; no metric recomputation or holdout access."
    },
    {
      "id": "release-recovery-simulation",
      "evidence_type": "deterministic 6-DoF simulation",
      "generator": "Analysis/run_release_recovery.py",
      "command": "python -m Analysis.run_release_recovery",
      "inputs": [
        "Analysis/sim_release_recovery.py",
        "Analysis/run_release_recovery.py",
        "Analysis/figure_style.py"
      ],
      "outputs": [
        "Figures/release_recovery_timeseries.png",
        "Figures/release_recovery_timeseries.pdf",
        "Figures/release_recovery_envelope.png",
        "Figures/release_recovery_envelope.pdf"
      ],
      "data_outputs": [
        "Data/release_recovery_results.json"
      ],
      "notes": "Uses encoded parameter tiers and placeholder or catalog-derived values; it is not based on assembled-hardware measurements.",
      "scope": "Historical designed aircraft"
    },
    {
      "id": "survivable-set-figures",
      "evidence_type": "Monte Carlo simulation",
      "generator": "Analysis/run_survivable_set.py",
      "command": "python -m Analysis.run_survivable_set --figures-only",
      "inputs": [
        "Data/survivable_set_results.json",
        "Data/survivable_set_results_a2.json",
        "Analysis/run_survivable_set.py",
        "Analysis/figure_style.py"
      ],
      "outputs": [
        "Figures/survivable_set_psafe.png",
        "Figures/survivable_set_policy.png",
        "Figures/survivable_set_psafe_a2.png",
        "Figures/survivable_set_policy_a2.png",
        "Figures/survivable_set_psafe.caption.md",
        "Figures/survivable_set_policy.caption.md",
        "Figures/survivable_set_psafe_a2.caption.md",
        "Figures/survivable_set_policy_a2.caption.md"
      ],
      "data_outputs": [],
      "notes": "Redraws the figures from the committed results without running the sweep. The full sweep (python -m Analysis.run_survivable_set) writes the same figures together with the results.",
      "scope": "Historical designed aircraft"
    },
    {
      "id": "guard-load-path",
