    {
      "id": "current-results-tables",
      "evidence_type": "calculation, deterministic and Monte Carlo simulation tables",
      "scope": "Historical designed aircraft",
      "generator": "Analysis/matlab/make_results_tables.m",
      "command": "python -m Analysis.export_results_tables && matlab -batch \"addpath('Analysis/matlab'); render_figures\" && python Analysis/matlab/typeset_tables.py Figures/tables",
      "inputs": [
        "Data/figure-data/current-results-tables.json",
        "Data/release_recovery_results.json",
        "Data/monte_carlo_results.json",
        "Analysis/export_results_tables.py"
      ],
      "outputs": [
        "Figures/tables/*.tex",
        "Figures/tables/*.pdf",
        "Figures/tables/*.png"
      ],
      "data_outputs": [
        "Data/figure-data/current-results-tables.json"
      ],
      "notes": "Typeset views of the tables in Analysis/current-results.md; the Markdown text stays under each image."
    }
  ]
